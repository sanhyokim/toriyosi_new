# 鶏好 — Apache 設定（今のサーバーにそのまま置く想定）
# mod_rewrite / mod_deflate / mod_expires / mod_headers が無効なサーバーでも壊れないよう <IfModule> で囲んでいます。

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset UTF-8
ErrorDocument 404 /404.html

AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2
AddType text/plain .txt

<IfModule mod_rewrite.c>
  RewriteEngine On

  # https と www なしに統一
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^(.*)$ https://toriyoshi.love/$1 [R=301,L]

  # 末尾スラッシュなしのディレクトリURLを統一
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]

  # WordPress 時代のURLを新しいページへ
  RewriteRule ^feed/?$ /news/ [R=301,L]
  RewriteRule ^news/feed/?$ /news/ [R=301,L]
  RewriteRule ^category/.*$ /news/ [R=301,L]
  RewriteRule ^(\d{4})/(\d{2})/.*$ /news/ [R=301,L]
  RewriteCond %{QUERY_STRING} ^p=\d+
  RewriteRule ^$ /? [R=301,L]
  RewriteRule ^(wp-login\.php|xmlrpc\.php)$ - [G,L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType text/javascript "access plus 1 week"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
